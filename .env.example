# OpenDirectory Environment Configuration
# Copy this file to .env and update with your values
#
# IMPORTANT: All passwords and secrets MUST be changed before deployment!
# Generate secure passwords with: openssl rand -base64 32

# ===================
# Environment
# ===================
NODE_ENV=development
LOG_LEVEL=info

# ===================
# Database Configuration
# Generate each with: openssl rand -base64 32
# ===================
DB_PASSWORD=
MONGO_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# ===================
# LDAP Configuration
# Generate with: openssl rand -base64 64
# ===================
LLDAP_JWT_SECRET=
LLDAP_ADMIN_PASSWORD=

# ===================
# LDAP Proxy
# ===================
LDAP_PROXY_PORT=1389
LLDAP_BASE_DN=dc=opendirectory,dc=local

# ===================
# Security
# JWT_SECRET: Generate with: openssl rand -base64 64
# ENCRYPTION_KEY: Must be exactly 32 characters: openssl rand -hex 16
# ===================
JWT_SECRET=
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY=

# ===================
# API Gateway Admin Credentials
# Used for Basic Auth on the API gateway
# ===================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===================
# API Gateway Keys (optional — if not set, API key auth is disabled)
# Generate with: openssl rand -hex 32
# ===================
API_KEY_READ_ONLY=
API_KEY_FULL=
API_KEY_ADMIN=

# ===================
# SSH Configuration
# Used for remote device management (prefer SSH keys in production)
# ===================
SSH_PASSWORD=

# CT2001 Device Connection
CT2001_HOST=192.168.1.51
CT2001_USERNAME=root
CT2001_PASSWORD=
CT2001_PORT=22

# Printer Discovery (optional — used for mock discovery endpoint)
PRINTER1_IP=192.168.1.200
PRINTER2_IP=192.168.1.201

# ===================
# Service URLs
# ===================
API_GATEWAY_URL=http://localhost:3000
API_BACKEND_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:3002
IDENTITY_SERVICE_URL=http://localhost:3001
DEVICE_SERVICE_URL=http://localhost:3003
POLICY_SERVICE_URL=http://localhost:3004

# ===================
# Frontend Configuration
# ===================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ===================
# Email Configuration (Optional)
# ===================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OpenDirectory <notifications@example.com>

# ===================
# Storage Configuration (Optional)
# Generate credentials with: openssl rand -base64 24
# ===================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=opendirectory

# ===================
# CORS & Security
# ===================
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ===================
# Monitoring (Optional)
# ===================
GRAFANA_PASSWORD=
PROMETHEUS_ENABLED=true
METRICS_PORT=9091

# ===================
# Conditional Access / Zero Trust (Optional)
# HIGH_RISK_COUNTRIES: comma-separated ISO-3166-1 alpha-2 codes
# ABUSEIPDB_API_KEY: https://www.abuseipdb.com (free tier available)
# VPN_DETECTION_SERVICE_URL: REST endpoint returning { isVPN: bool }
# PROXY_DETECTION_SERVICE_URL: REST endpoint returning { isProxy: bool }
# MAX_ACTIVE_SESSIONS: max sessions evaluated per tick (default 10000)
# ===================
HIGH_RISK_COUNTRIES=CN,RU,IR,KP
ABUSEIPDB_API_KEY=
VPN_DETECTION_SERVICE_URL=
PROXY_DETECTION_SERVICE_URL=
MAX_ACTIVE_SESSIONS=10000

# ===================
# OAuth2 / OIDC Identity Provider (Entra ID Ersatz)
# ===================
OAUTH_ISSUER=https://opendirectory.local
OAUTH_PROVIDER_PORT=3010
OAUTH_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# ===================
# Enrollment Hub (Intune + ABM Ersatz)
# Enrollment tokens werden automatisch generiert
# APNS: Apple Push Notification Service für iOS MDM
# ===================
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.opendirectory.mdm
APNS_PRIVATE_KEY_PATH=/etc/opendirectory/apns.key

ENROLLMENT_TOKEN_TTL_DAYS=30
ENROLLMENT_MAX_USES_WINDOWS=50
ENROLLMENT_MAX_USES_MACOS=50
ENROLLMENT_MAX_USES_LINUX=100
ENROLLMENT_MAX_USES_IOS=25
ENROLLMENT_MAX_USES_ANDROID=25

# ===================
# Least Privilege Service
# ===================
LEAST_PRIVILEGE_PORT=3011

# ===================
# Certificate Authority
# ===================
CA_PORT=3012
CA_COMMON_NAME=OpenDirectory Internal CA
CA_ORG=OpenDirectory
CA_COUNTRY=CH
CA_VALIDITY_YEARS=10

# ===================
# Kerberos KDC
# ===================
KRB5_REALM=OPENDIRECTORY.LOCAL
KDC_HOST=kerberos-kdc
KRB5_ADMIN_PASSWORD=
KRB5_DB_PASSWORD=
KDC_API_URL=http://kerberos-kdc:3013

# ===================
# Apple MDM Service (port 3014)
# MDM push requires a special MDM push certificate — NOT a regular APNs cert.
# Obtain one via Apple Business Manager + Apple Push Certificates Portal:
#   https://identity.apple.com/pushcert/
# APNS_CERT / APNS_KEY: base64-encoded PEM (e.g. base64 -w0 < cert.pem)
# APNS_TOPIC: the UID field of the MDM push cert (com.apple.mgmt.External.<UUID>)
# MDM_SERVER_URL: public HTTPS URL of this server (required for device enrollment)
# ===================
APPLE_MDM_PORT=3014
MDM_SERVER_URL=https://mdm.opendirectory.local
MDM_ORG_NAME=OpenDirectory
MDM_PUSH_CERT_PATH=
MDM_TOPIC=com.apple.mgmt.External.YOUR_UUID
APNS_CERT=
APNS_KEY=

# ===================
# Feature Flags
# ===================
FEATURE_OAUTH_PROVIDER_ENABLED=true
FEATURE_SAML_ENABLED=true
FEATURE_FIDO2_ENABLED=true
FEATURE_MDM_ENABLED=true
FEATURE_CONDITIONAL_ACCESS_ENABLED=true
FEATURE_CERTIFICATE_MANAGEMENT_ENABLED=true
FEATURE_UPDATE_MANAGEMENT_ENABLED=true
FEATURE_PRINT_MANAGEMENT_ENABLED=true
FEATURE_LICENSE_MANAGEMENT_ENABLED=true
FEATURE_ENROLLMENT_HUB_ENABLED=true
